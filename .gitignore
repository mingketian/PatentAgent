# ── secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ── python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── generated artefacts ───────────────────────────────────────
# Evaluation runs write here; regenerated by the commands in docs/EVALUATION_RESULTS.md
outputs/
data/cache/

# Large prebuilt indexes are not committed. The 112-patent demo index under
# data/indexes/par4pc_patentsberta_demo/ is the one exception - see data/README.md.
data/indexes/*
!data/indexes/par4pc_patentsberta_demo/
!data/indexes/par4pc_patentsberta_demo/**

# ── os / editor ───────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
